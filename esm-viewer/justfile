# Run from esm-viewer/.
# Install `just` once: cargo install just
#
# Usage:
#   just          -> lint + format check + typecheck + test (the local CI pass for this app)
#   just addon    -> rebuild the ../esm/bindings/napi native addon
#   just dev      -> launch the Electron app in dev mode
#   just build    -> production build (electron-vite build)

default: check

# Rebuild the native N-API addon this app depends on.
# Run after any Rust API change under ../esm/bindings/napi.
addon:
    bun run build:addon

# oxlint (correctness/suspicious/perf + react/import/vitest, see .oxlintrc.json), then
# oxfmt --check (see .oxfmtrc.json), then type-check main/preload (Node lib) and renderer
# (DOM lib) separately — they use different tsconfigs, see tsconfig.json /
# tsconfig.node.json — then run the bun:test unit suite. Fast checks first.
check:
    bun run lint:ci
    bun run format:check
    bun run typecheck
    bun run test

# Launch the app in dev mode (electron-vite dev). Rebuilds the addon first.
dev:
    bun run dev

# Production build (electron-vite build). Rebuilds the addon first.
build:
    bun run build
