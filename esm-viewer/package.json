{
  "name": "@fo76/esm-viewer",
  "version": "0.1.0",
  "description": "FO76 ESM Viewer — Fallout 76 ESM record browser",
  "productName": "FO76 ESM Viewer",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "bun run build:addon",
    "dev": "electron-vite dev",
    "prebuild": "bun run build:addon",
    "build": "electron-vite build",
    "build:addon": "bun run --cwd ../esm/bindings/napi build",
    "preview": "electron-vite preview",
    "package:dir": "electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ci": "oxlint --deny-warnings --format=github",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postinstall": "bun node_modules/electron/install.js"
  },
  "dependencies": {
    "@fo76/esm-napi": "file:../esm/bindings/napi"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.5",
    "@types/bun": "^1.3.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "electron": "^34",
    "electron-builder": "^25",
    "electron-vite": "^2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^7.0.2",
    "vite": "^5",
    "zustand": "^5"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
