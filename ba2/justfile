# Run from ba2/.  Mirrors the CI checks exactly.
# Install `just` once: cargo install just
#
# Usage:
#   just          -> fmt + clippy + test  (the full local CI pass)
#   just baseline-check DIR -> compare DIR's real archives with tests/baselines/playtest.tsv
#   just baseline DIR       -> rewrite that manifest from DIR's archives

default: check

# Run the full check suite (same as CI rust matrix).
[doc("fmt, clippy and test")]
check: fmt clippy test

# Verify formatting.
fmt:
    cargo fmt -p ba2 --check

# Lint (deny warnings), with the CLI and as the library alone.
clippy:
    cargo clippy -p ba2 --all-targets -- -D warnings
    cargo clippy -p ba2 --no-default-features --all-targets -- -D warnings

# Run all tests, with the CLI and as the library alone.
test:
    cargo test -p ba2
    cargo test -p ba2 --no-default-features

# Compare the real archives in DIR (the Playtest install's Data folder) with
# tests/baselines/playtest.tsv.
[doc("Compare DIR's real archives with tests/baselines/playtest.tsv")]
baseline-check dir:
    BA2_BASELINE_DIR="{{dir}}" cargo test --release --test baseline -- --nocapture

# Rewrite tests/baselines/playtest.tsv from the archives in DIR.
baseline dir:
    BA2_BASELINE_DIR="{{dir}}" BA2_BASELINE_WRITE=1 cargo test --release --test baseline
