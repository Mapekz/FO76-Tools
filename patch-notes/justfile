# Run from patch-notes/. The Python patch-notes pipeline: the mechanical stage
# (`pn/`), its tests, and the /patch-notes skill (`skill/`).
# Install `just` once: cargo install just
#
# Usage:
#   just          -> test + lint (the local CI pass for this project)
#   just test     -> unittest suite (hermetic: no game data, no esm binary)
#   python3 -m pn --help -> every pipeline verb
#   just lint     -> ruff + ty over pn/, tests/ and cli.py
#   just run OLD NEW -> mechanical stage for two snapshot directories

default: check

[doc("test + lint")]
check: test lint

[doc("The hermetic unittest suite")]
test:
    python3 -m unittest discover -s tests -t .

# ruff and ty run through uvx at the versions CI pins (see the `python` job in
# ../.github/workflows/ci.yml); config lives in pyproject.toml.
#
# Lint and typecheck pn/, tests/ and cli.py.
lint:
    uvx ruff@0.15.22 check pn/ tests/ cli.py
    uvx ty@0.0.62 check pn/ tests/ cli.py

# Mechanical patch-notes stage: diff.json, comprehensive.json, bundles.json,
# lints.json and manifest.json into the output dir. The narrative stage is the
# /patch-notes skill (`skill/SKILL.md`).
#
# `esm diff` finds each snapshot's strings and curve tables in its own folder;
# the env vars below override that for both sides.
#
# Usage:
#   just run /path/to/v1/ /path/to/v2/
#   OUT_DIR=/path/to/out just run /path/to/old/ /path/to/new/
#
# Env vars (all optional):
#   STRINGS_DIR    Strings directory for both ESMs.
#   STARTUP_BA2    Startup BA2 for curve tables, both ESMs.
#   CURVES_DIR     Loose misc/ directory for curve tables, both ESMs.
#   ESM_LANG       Localization language code (default: en). Named ESM_LANG to
#                  avoid collision with the system $LANG locale variable.
#   OUT_DIR        Output directory (default: patch_<old>_to_<new>/ next to NEW).
#
# Run the mechanical stage for two snapshot directories.
run old new:
    python3 -m pn run \
        "{{old}}" "{{new}}" \
        ${STRINGS_DIR:+--strings-dir "$STRINGS_DIR"} \
        ${STARTUP_BA2:+--startup-ba2 "$STARTUP_BA2"} \
        ${CURVES_DIR:+--curves-dir "$CURVES_DIR"} \
        ${ESM_LANG:+--lang "$ESM_LANG"} \
        ${OUT_DIR:+--out-dir "$OUT_DIR"}
